{
  "name": "webdav-webui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "纯前端 WebDAV 文件管理器（Vite + React + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "serve:prefix": "node tools/serve-prefix.mjs",
    "mock:dav": "node tools/mock-webdav.mjs",
    "mock:dav:no-cors": "node tools/mock-webdav.mjs --no-cors --port=8789",
    "mock:dav:digest": "node tools/mock-webdav.mjs --digest --port=8788"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
